# ============================================
# JAVBANK - .gitignore
# ============================================

# ============================================
# Java compiled files
# ============================================
*.class
*.jar
*.war
*.ear

# ============================================
# Maven build directory
# ============================================
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ============================================
# IntelliJ IDEA
# ============================================
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/
.idea/workspace.xml
.idea/tasks.xml
.idea/dataSources.xml
.idea/compiler.xml
.idea/encodings.xml
.idea/misc.xml
.idea/libraries/
.idea/modules/
.idea/caches/
.idea/inspectionProfiles/
.idea/runConfigurations/
.idea/shelf/
.idea/httpRequests/
.idea/jarRepositories.xml

# ============================================
# VS Code
# ============================================
.vscode/
*.code-workspace
.settings/
.classpath
.project

# ============================================
# Logs
# ============================================
*.log
logs/
banking.log
*.log.gz
*.log.zip

# ============================================
# Application Properties (Sensitive Data)
# ============================================
application-local.properties
application-dev.properties
application-prod.properties
application-production.properties
application-*.properties
!application.properties
!application-example.properties

# ============================================
# Database backups
# ============================================
*.sqlite
*.db
*.sql.gz
*.sql.zip

# ============================================
# Backups & temporary files
# ============================================
*.backup
*.bak
*.old
*.orig
*.tmp
*.temp
Thumbs.db
.DS_Store
*.swp
*.swo
*~

# ============================================
# Secrets / Credentials
# ============================================
.env
*.p12
*.pfx
*.jks
*.pem
*.key
*.crt
*.csr
*.cer
*.secret
*.keystore
*.truststore